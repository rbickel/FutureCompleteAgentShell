{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.27/MicrosoftTeams.schema.json",
    "manifestVersion": "1.27",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "My App, Inc.",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "FutureComplete${{APP_NAME_SUFFIX}}",
        "full": "FutureComplete Forecasting Agent"
    },
    "description": {
        "short": "Prepare forecasts and backtests from Teams.",
        "full": "FutureComplete helps Teams users prepare forecasting and backtesting jobs, upload time-series datasets, configure parameters, and inspect completed results in the FutureComplete dashboard."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "team",
                "groupChat",
                "personal",
                "copilot"
            ],
            "supportsFiles": true,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": [
                        "personal"
                    ],
                    "commands": [
                        {
                            "title": "Start a forecast",
                            "description": "Generate future predictions from an uploaded time-series dataset."
                        },
                        {
                            "title": "Run a backtest",
                            "description": "Evaluate historical predictive performance for a dataset."
                        },
                        {
                            "title": "Show my jobs",
                            "description": "List recent FutureComplete jobs and dashboard links when available."
                        },
                        {
                            "title": "Clear chat",
                            "description": "Clear the current conversation and start over."
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "futurecomplete.inait.ai",
        "github.com"
    ],
    "copilotAgents": {
        "customEngineAgents": [
            {
                "type": "bot",
                "id": "${{BOT_ID}}"
            }
        ]
    }
}