{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceBaseName": {
      "value": "bot${{RESOURCE_SUFFIX}}"
    },
    "azureOpenaiKey": {
      "value": "${{SECRET_AZURE_OPENAI_API_KEY}}"
    },
    "azureOpenaiModelDeploymentName" : {
      "value": "${{AZURE_OPENAI_DEPLOYMENT_NAME}}"
    },
    "azureOpenaiEndpoint" : {
      "value": "${{AZURE_OPENAI_ENDPOINT}}"
    },
    "futurecompleteApiBaseUrl": {
      "value": "https://api.forecasting.inait.ai"
    },
    "futurecompleteDashboardUrl": {
      "value": "https://futurecomplete.inait.ai"
    },
    "futurecompleteTrialUsersUrl": {
      "value": "https://api.forecasting.inait.ai/users/dev/users"
    },
    "futurecompleteTrialPlanId": {
      "value": "trial"
    },
    "futurecompleteJobStatusPathTemplate": {
      "value": "/v1/sessions/{session_id}/status"
    },
    "futurecompleteJobResultPathTemplate": {
      "value": "/v1/sessions/{session_id}/result"
    },
    "futurecompleteJobCancelPathTemplate": {
      "value": "/v1/sessions/{session_id}/cancel"
    },
    "webAppSKU": {
      "value": "B1"
    },
    "botDisplayName": {
      "value": "FutureCompleteAgentShell"
    },
    "linuxFxVersion": {
      "value": "PYTHON|3.11"
    }
  }
}